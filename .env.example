# ==========================================
# StayGames - Environment Configuration
# ==========================================

# Application Port
PORT=3000

# Security / Session Token (replace with a long random secret in production)
JWT_SECRET=super_secret_game_night_jwt_key_staygames_2026
JWT_EXPIRES_IN_SECONDS=1209600
COOKIE_SECURE=false

# Database Configuration (MySQL 8.0)
DB_HOST=mysql
DB_PORT=3306
DB_USER=staygames
DB_PASSWORD=staygames_secret
DB_NAME=staygames
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_EXTERNAL_PORT=3306

# ------------------------------------------
# LDAP / Active Directory Configuration
# ------------------------------------------
# For external LDAP (e.g., FreeIPA, Active Directory, Authentik, OpenLDAP):
LDAP_URL=ldap://openldap:389
LDAP_BASE_DN=dc=staygames,dc=local
LDAP_BIND_DN=cn=admin,dc=staygames,dc=local
LDAP_BIND_PASSWORD=admin

LDAP_USER_SEARCH_BASE=ou=users,dc=staygames,dc=local
LDAP_USER_SEARCH_FILTER=(&(objectClass=inetOrgPerson)(uid=%s))
LDAP_SYNC_FILTER=(objectClass=inetOrgPerson)

LDAP_ATTR_UID=uid
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_DISPLAY_NAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_SYNC_ON_STARTUP=true

# Set to true if you don't have an LDAP server running and want built-in mock logins:
# (mock accounts: alice, bob, charlie, diana, erik with password: password)
LDAP_MOCK_MODE=false
